# Normaliza as quebras de linha para LF, alinhado ao .editorconfig/ktlint.
# Sem isso, em Windows o git reintroduz CRLF no checkout e o spotlessCheck falha sempre.
* text=auto eol=lf

*.bat text eol=crlf
gradlew text eol=lf
*.jar binary
*.png binary
*.jpg binary
*.webp binary
*.ttf binary
*.otf binary
